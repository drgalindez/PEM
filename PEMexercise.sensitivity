              "summary": "{\n  \"name\": \"df_lut\",\n  \"rows\": 11,\n  \"fields\": [\n    {\n      \"column\": \"Epsilon_max\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.00019028782027616625,\n        \"min\": 0.0006,\n        \"max\": 0.0011,\n        \"num_unique_values\": 7,\n        \"samples\": [\n          0.000908,\n          0.0011,\n          0.00066\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Tmin_start\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1.5251360595042,\n        \"min\": 7.94,\n        \"max\": 12.02,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          8.8,\n          9.09,\n          10.24\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Tmin_stop\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.0,\n        \"min\": -8.0,\n        \"max\": -8.0,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          -8.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"VPD_start\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 715.668790839602,\n        \"min\": 3100.0,\n        \"max\": 5000.0,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          3600.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"VPD_stop\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 185.9080906841286,\n        \"min\": 610.0,\n        \"max\": 1100.0,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          1100.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"sla\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 9.363701676736028,\n        \"min\": 12.0,\n        \"max\": 40.0,\n        \"num_unique_values\": 9,\n        \"samples\": [\n          12.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"q10_mr\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.0,\n        \"min\": 2.0,\n        \"max\": 2.0,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          2.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"froot_leaf_ratio\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.303614588222994,\n        \"min\": 1.0,\n        \"max\": 2.0,\n        \"num_unique_values\": 8,\n        \"samples\": [\n          1.1\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"livewood_leaf_ratio\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.06651821350030927,\n        \"min\": 0.0,\n        \"max\": 0.203,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          0.04\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"leaf_mr_base\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.001280927930695698,\n        \"min\": 0.00519,\n        \"max\": 0.00908,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          0.00714\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"froot_mr_base\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.00030151134457776364,\n        \"min\": 0.00519,\n        \"max\": 0.00619,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          0.00619\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"livewood_mr_base\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.0015580138872061677,\n        \"min\": 0.0,\n        \"max\": 0.00436,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          0.00218\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"leaf_gr_base\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 5.822058658345462e-17,\n        \"min\": 0.3,\n        \"max\": 0.3,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          0.3\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"froot_leaf_gr_ratio\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.36630836488103596,\n        \"min\": 1.0,\n        \"max\": 2.0,\n        \"num_unique_values\": 6,\n        \"samples\": [\n          1.3\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"livewood_leaf_gr_ratio\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.0840021644742779,\n        \"min\": 0.0,\n        \"max\": 0.22,\n        \"num_unique_values\": 8,\n        \"samples\": [\n          0.2\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"deadwood_leaf_gr_ratio\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.744433891075506,\n        \"min\": 0.0,\n        \"max\": 1.8,\n        \"num_unique_values\": 7,\n        \"samples\": [\n          1.6\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"ann_turnover_fraction\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.3551568155566829,\n        \"min\": 0.25,\n        \"max\": 1.0,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          0.25\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
